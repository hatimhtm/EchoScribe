# ─── OpenAI (required) ──────────────────────────────────────────────
# One key drives both Whisper (transcription) and GPT (intelligence).
OPENAI_API_KEY=sk-your-openai-api-key

# Defaults are fine — override only if you know why.
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TEMPERATURE=0.2

# ─── Slack (optional) ───────────────────────────────────────────────
# Only required when posting summaries to Slack (--slack flag / server
# with post_to_slack=true).
SLACK_API_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#meetings

# ─── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
